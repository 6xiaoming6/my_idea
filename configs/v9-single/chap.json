{
  "output_dir": "outputs/v9-single",
  "model": {
    "version": "v9-single",
    "main": {
      "architecture": "v9_coarse_to_fine_residual_moe",
      "prediction_mode": "coarse_to_fine_residual",
      "scale_mode": "fine_mid_coarse",
      "num_experts": 4,
      "top_k": 2,
      "share_experts": false,
      "use_router": true,
      "use_routed_branch": true,
      "use_shared_branch": false,
      "enable_branch_aux": false,
      "enable_complementary_loss": false,
      "routing_mode": "topk",
      "alpha_m_init": -3.0,
      "alpha_f_init": -3.0,
      "alpha_mode": "learnable",
      "enable_mid_residual": true,
      "enable_fine_residual": true,
      "zero_init_residual_heads": false,
      "dropout": 0.1
    }
  },
  "loss": {
    "type": "smooth_l1",
    "lambda_cross": 0.0,
    "use_mid_coarse_supervision": true,
    "lambda_mid_supervision": 0.2,
    "lambda_coarse_supervision": 0.1,
    "lambda_balance": 0.01,
    "lambda_importance_balance": 0.001,
    "lambda_load_balance": 0.001,
    "lambda_shared_aux": 0.0,
    "lambda_route_aux": 0.0,
    "lambda_complementary": 0.0,
    "lambda_fusion_entropy": 0.0,
    "lambda_branch_entropy": 0.0,
    "lambda_final": 0.0
  }
}
