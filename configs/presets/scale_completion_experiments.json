{
  "output_dir": "outputs/v23/scale_completion/comparison",
  "datasets": ["TaxiBJ", "BikeNYC", "CHAP"],
  "patterns": ["fixed", "random"],
  "rate": 0.4,
  "seeds": [42, 2026, 3407],
  "ablation_seed": 42,
  "train_windows": 512,
  "epochs": 120,
  "val_epoch": 2,
  "batch_size": 4,
  "cpu_threads": 2,
  "timing_safety_factor": 1.6,
  "variants": {
    "B00": {"role": "main", "description": "原 A01：可学习聚合器均匀融合、补全路由，无分支监督", "patch": {"model": {"dual_moe": {"design": "learned_regions_v2"}}, "loss": {"dual_moe_expert_weight": 0}}},
    "B01": {"role": "main", "description": "原 A01 + 0.01 分支监督", "patch": {"model": {"dual_moe": {"design": "learned_regions_v2"}}}},
    "N01": {"role": "main", "description": "新模型：有界残差 + 0.01 分支监督", "patch": {}},
    "N00": {"role": "ablation", "description": "新模型取消分支监督", "patch": {"loss": {"dual_moe_expert_weight": 0}}},
    "NU": {"role": "ablation", "description": "新模型补全权重改为均匀融合", "patch": {"model": {"dual_moe": {"completion_mode": "uniform"}}}},
    "NG": {"role": "ablation", "description": "新模型改为规则观测归一化聚合，非等容量消融", "patch": {"model": {"dual_moe": {"aggregation_kind": "regular_grid"}}, "loss": {"dual_moe_partition_weight": 0}}},
    "NB2": {"role": "ablation", "description": "新模型归一化残差上限从 1 放宽到 2", "patch": {"model": {"dual_moe": {"residual_bound": 2}}}}
  }
}
