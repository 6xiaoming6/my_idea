{
  "output_dir": "outputs/v23/scale_completion/regular_grid",
  "data": {
    "batch_size": 4,
    "drop_last": false
  },
  "model": {
    "architecture": "dual_moe",
    "dual_moe": {
      "dim": 32,
      "key_dim": 8,
      "depth": 1,
      "num_groups": 4,
      "dropout": 0,
      "min_std": 1,
      "aggregation_mode": "uniform",
      "aggregation_geometry": true,
      "completion_mode": "learned",
      "completion_use_support": true,
      "coarse_nodes": [
        32,
        8
      ],
      "aggregation_experts": 3,
      "assignment_temperature": 0.5,
      "design": "anchored_scale_moe",
      "aggregation_kind": "regular_grid",
      "residual_bound": 1,
      "grid_strides": [
        4,
        8
      ]
    },
    "aux": {
      "enabled": false
    }
  },
  "loss": {
    "type": "smooth_l1",
    "dual_moe_expert_weight": 0.01,
    "dual_moe_partition_weight": 0
  },
  "train": {
    "epochs": 80,
    "val_epoch": 2,
    "lr_main": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1,
    "amp": true,
    "scheduler": {
      "type": "cosine",
      "eta_min": 0.000001
    },
    "early_stopping": {
      "enabled": false
    }
  }
}
