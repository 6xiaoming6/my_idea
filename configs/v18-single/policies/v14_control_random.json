        "early_stopping": {
          "enabled": true,
          "monitor": "val_mae",
          "patience": 12,
          "mode": "min"
        }
      }
    },
    "CHAP": {
      "evaluation": {
        "masked_metric_aggregation": "global_missing_elements",
        "selection_metric": "val_mae"
      },
      "train": {
        "epochs": 150,
        "val_epoch": 5,
