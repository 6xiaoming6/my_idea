{
  "output_dir": "outputs/v21-single-smoke",
  "device": "cpu",
  "data": {
    "batch_size": 2,
    "scales": {
      "pyramid_mode": "observation_moment"
    },
    "synthetic": {
      "num_train": 4,
      "num_val": 2,
      "t": 3,
      "h": 16,
      "w": 16
    }
  },
  "model": {
    "version": "v21-single-smoke",
    "architecture": "v14_safe_c2f_moe",
    "main": {
      "dim": 8,
      "num_experts": 2,
      "top_k": 1,
      "max_t": 3,
      "h": 16,
      "w": 16,
      "num_groups": 2,
      "dropout": 0.0,
      "route_dropout": 0.0,
      "evidence_dim": 7,
      "evidence_zero_init": true
    },
    "v14": {
      "enabled": true,
      "reuse_main_features": true,
      "use_main_bypass": true,
      "difficulty_hidden": 8,
      "difficulty_out_dim": 8,
      "controller_hidden": 16,
      "controller_dropout": 0.0,
      "refiner_hidden": 8,
      "prediction_embed_dim": 4,
      "correction_hidden": 4,
      "refiner_dropout": 0.0
    }
  },
  "loss": {
    "lambda_v14_base": 0.25,
    "lambda_v14_mid": 0.05,
    "lambda_v14_coarse": 0.03,
    "lambda_v14_regret": 0.1,
    "lambda_v14_gate": 0.0001
  },
  "train": {
    "epochs": 1,
    "val_epoch": 1,
    "amp": false,
    "early_stopping": {
      "enabled": false
    }
  }
}
