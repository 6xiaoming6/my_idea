        "val": "data/TaxiBJ/v24_clean_abc_20260917/taxibj_val.npz",
        "test": "data/TaxiBJ/v24_clean_abc_20260917/taxibj_test.npz"
      }
    }
  },
  "default_study": "coe_validation"
}
