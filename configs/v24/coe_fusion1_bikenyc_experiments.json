    "measure_forward_latency": true,
    "oracle_last_step_samples": 0,
    "best_checkpoint_name": "best.pth"
  },
  "studies": {
    "coe_fusion1_bikenyc": {
      "base_config": "configs/v24/coe_main_s4_e8_bikenyc_base.json",
      "stage": "coe_fusion1",
      "sources": {
        "train": "data/BikeNYC/bikenyc_train.npz",
        "val": "data/BikeNYC/bikenyc_val.npz",
        "test": "data/BikeNYC/bikenyc_test.npz"
      }
    }
  },
  "default_study": "coe_fusion1_bikenyc"
}
