{
  "schema_version": 1,
  "output_dir": "outputs/v24-COE/experiments/coe_direct_baselines",
  "cpu_threads": 2,
  "batch_size": 32,
  "seeds": [
    7
  ],
  "extra_inputs": [],
  "training": {
    "epochs": 100,
    "val_epoch": 5,
    "save_best_checkpoint": true,
    "early_stopping": {
      "enabled": false
    },
    "scheduler": {
      "type": "cosine",
      "total_epochs": 100,
      "eta_min": 0.0003,
      "reach_min_at_last_epoch": true
    },
    "router_grad_diagnostic_every": 0,
    "full_checkpoint": true,
    "measure_forward_latency": true,
    "oracle_last_step_samples": 0,
    "best_checkpoint_name": "best.pth",
    "lr_main": 0.001,
    "save_last_checkpoint": true
  },
  "studies": {
    "coe_direct_baselines_bikenyc": {
      "base_config": "configs/v24/coe_main_s4_e8_bikenyc_base.json",
      "stage": "coe_direct_baselines",
      "sources": {
        "train": "data/BikeNYC/bikenyc_train.npz",
        "val": "data/BikeNYC/bikenyc_val.npz",
        "test": "data/BikeNYC/bikenyc_test.npz"
      }
    }
  },
  "default_study": "coe_direct_baselines_bikenyc"
}
