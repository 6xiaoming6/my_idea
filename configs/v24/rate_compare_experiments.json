{
  "schema_version": 1,
  "output_dir": "outputs/v24-COE/experiments/coe_rate_compare",
  "dataset": "TaxiBJ",
  "train_npz": "data/TaxiBJ/taxibj_train.npz",
  "val_npz": "data/TaxiBJ/taxibj_val.npz",
  "test_npz": "data/TaxiBJ/taxibj_test.npz",
  "base_config": "configs/v24/coe_main_base.json",
  "variants": ["A0", "A2"],
