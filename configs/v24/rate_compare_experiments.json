  "seed": 7,
  "epochs": 100,
  "val_epoch": 5,
  "batch_size": 16,
  "save_best_checkpoint": true,
  "scheduler": {"type": "cosine", "total_epochs": 100, "eta_min": 1e-6},
  "early_stopping": {"enabled": false},
  "variants_config": {
    "A0": {},
    "A2": {
      "model": {"coe": {"routing_mode": "soft", "routing_warmup_epochs": 0, "routing_transition_epochs": 0, "global_route_weights": false}},
      "loss": {"lambda_coe_balance": 0.01}
    }
  }
}
