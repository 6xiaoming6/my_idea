{
  "name": "v10_quick_5epoch",
  "datasets": {
    "TaxiBJ": {
      "seed": 42,
      "data": {
        "batch_size": 8,
        "num_workers": 0,
        "pin_memory": true,
        "drop_last": false
      },
      "train": {
        "epochs": 5,
        "val_epoch": 1,
        "lr_main": 0.001,
        "lr_aux": 0.001,
        "weight_decay": 0.0001,
        "grad_clip_norm": 1.0,
        "amp": true,
        "scheduler": {
          "type": "cosine",
          "eta_min": 0.000001
        },
        "early_stopping": {
          "enabled": false
        }
      }
    },
