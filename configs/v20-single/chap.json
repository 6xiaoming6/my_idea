{
  "output_dir": "outputs/v20-single",
  "model": {
    "version": "v20-single",
    "architecture": "v20_probe_validated_c2f_moe",
    "v14": {
      "enabled": true,
      "reuse_main_features": true,
      "use_main_bypass": true,
      "refiner_hidden": 32,
      "prediction_embed_dim": 16,
      "correction_hidden": 16,
      "refiner_dropout": 0.1,
      "difficulty_enabled": true,
      "difficulty_hidden": 32,
      "difficulty_out_dim": 32,
      "difficulty_use_spatial_block": true,
      "difficulty_use_cross_scale_consistency": true,
      "controller_hidden": 64,
      "controller_dropout": 0.1,
      "controller_zero_init": true,
      "dynamic_gate": true,
      "alpha_mid_bias": -3.0,
      "alpha_fine_bias": -3.0,
      "alpha_final_bias": -5.0,
      "alpha_mid_max": 0.8,
      "alpha_fine_max": 0.8,
      "alpha_final_max": 0.5,
      "correction_zero_init": true,
      "fine_uses_main_feature": true,
      "use_observed_consistency": true,
      "use_geometry_descriptor": true,
      "use_scale_reliability": true,
      "freeze_main": false,
      "lambda_base": 0.25,
      "lambda_mid": 0.05,
      "lambda_coarse": 0.03,
      "lambda_regret": 0.1,
      "lambda_gate": 0.0001
    },
    "v20": {
      "enabled": true,
      "probe_enabled": true,
      "probe_mode": "geometry_matched",
      "routing_fusion": "neutral_hybrid",
      "confidence_mode": "entropy_threshold",
      "competence_entropy_threshold": 0.02,
      "competence_entropy_saturation": 0.08,
      "routing_evidence_scales": ["fine"],
      "apply_evidence_during_training": false,
      "probe_ratio": 0.08,
      "probe_min_count": 8,
      "probe_max_count": 128,
      "probe_min_remaining": 16,
      "spatial_kernel_small": 3,
      "spatial_kernel_large": 7,
      "temporal_kernel": 3,
      "reliability_kernel": 5,
      "probe_temperature": 0.5,
      "probe_eta_max": 0.25,
      "validation_calibration": {
        "enabled": true,
        "monitor": "mae",
        "mode": "min",
        "eta_candidates": [0.0, 0.05, 0.1, 0.15, 0.25]
      },
      "probe_eps": 0.000001,
      "probe_decoder_zero_init": true,
      "probe_decoder_dropout": 0.0,
      "probe_decoder_seed": 2020,
      "detach_probe_features": true,
      "detach_routing_evidence": true,
      "active_scale_only": true,
      "descriptor_weights": {
        "spatial_small": 1.0,
        "spatial_large": 1.0,
        "temporal": 0.5,
        "reliability": 1.0
      }
    }
  },
  "loss": {
    "lambda_v14_base": 0.25,
    "lambda_v14_mid": 0.05,
    "lambda_v14_coarse": 0.03,
    "lambda_v14_regret": 0.1,
    "lambda_v14_gate": 0.0001,
    "lambda_v20_probe": 0.05
  },
  "train": {
    "epochs": 150,
    "val_epoch": 5,
    "lr_v14": 0.001,
    "lr_v20": 0.001,
    "grad_clip_isolate_groups": ["v20", "v20_no_decay"],
    "grad_clip_norm_isolated": 1.0,
    "early_stopping": {
      "enabled": false,
      "monitor": "val_mae",
      "patience": 8,
      "mode": "min"
    }
  }
}
