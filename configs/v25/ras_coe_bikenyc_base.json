{
  "seed": 7,
  "output_dir": "outputs/v25-RAS-CoE",
  "device": "cuda",
  "data": {
    "dataset_name": "BikeNYC",
    "batch_size": 32,
    "num_workers": 0,
    "pin_memory": true,
    "drop_last": false,
    "mask": {
      "pattern": "random",
      "missing_rate": 0.4
    },
    "synthetic": {
      "num_train": 128,
      "num_val": 32,
      "t": 12,
      "h": 24,
      "w": 12
    },
    "multiscale": false,
    "loader_seed": 7,
    "train_mask_diversity": {
      "families": [
        "random_point",
        "node_outage",
        "temporal_gap",
        "spatial_region",
        "spatiotemporal_block",
        "stripe",
        "moving_region",
        "multi_block",
        "composite"
      ],
      "rates": [
        0.4
      ],
      "seed": 20260917,
      "resample_each_epoch": true
    },
    "eval_mask_diversity": {
      "families": [
        "random_point",
        "node_outage",
        "temporal_gap",
        "spatial_region",
        "spatiotemporal_block",
        "stripe",
        "moving_region",
        "multi_block",
        "composite"
      ],
      "rates": [
        0.4
      ],
      "seed": 20260917,
      "resample_each_epoch": false
    }
  },
  "model": {
    "architecture": "v25_ras_coe",
    "c_in": 2,
    "main": {
      "dim": 64,
      "max_t": 12,
      "h": 24,
      "w": 12,
      "scale_mode": "fine",
      "use_multiscale": false
    },
    "coe": {
      "num_steps": 4,
      "expert_pool": [
        "T",
        "S",
        "TD",
        "SD",
        "TA",
        "ST",
        "TL",
        "SL"
      ],
      "routing_mode": "hard",
      "fixed_path": null,
      "fixed_expert_steps": [
        null,
        null,
        null,
        null
      ],
      "router_state": "dynamic",
      "expert_state": "dynamic",
      "use_shared": true,
      "use_routed": true,
      "temperature": 1.0,
      "temporal_kernel": 3,
      "spatial_kernel": 3,
      "temporal_dilation": 2,
      "spatial_dilation": 2,
      "attention_heads": 4,
      "residual_init": 0.1,
      "routing_warmup_epochs": 3,
      "routing_transition_epochs": 3,
      "uniform_mix_start": 0.5,
      "sampling_temperature_start": 2.0,
      "top_k": 2,
      "router_hidden_dim": 64,
      "pair_mode": "partner_residual",
      "acceptance": "none",
      "expert_sharing": "shared",
      "previous_expert_context": false,
      "global_route_weights": false,
      "router_input_noise_std": 0.0,
      "router_input_noise_steps": 0,
      "completion_feedback": false,
      "partner_fusion": "corrected",
      "partner_aux_head_only": true,
      "repair_acceptance": "none",
      "repair_feedback_to_router": false,
      "repair_accept_aux_head_only": true,
      "repair_accept_init_prob": 0.99,
      "state_update_mode": "residual"
    },
    "aux": {
      "enabled": false,
      "alpha_init": 0.0
    }
  },
  "loss": {
    "type": "l1",
    "lambda_coe_mid": 0.0,
    "lambda_coe_balance": 0.01,
    "lambda_coe_z": 0.0,
    "balance_importance": "candidate",
    "lambda_coe_accept": 0.0,
    "lambda_coe_monotonic": 0.0,
    "repair_accept_margin": 0.0,
    "repair_monotonic_tolerance": 0.0
  },
  "train": {
    "epochs": 100,
    "val_epoch": 5,
    "lr_main": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "amp": true,
    "save_every": 10,
    "scheduler": {
      "type": "cosine",
      "total_epochs": 100,
      "eta_min": 0.0003,
      "reach_min_at_last_epoch": true
    },
    "early_stopping": {
      "enabled": false
    },
    "save_best_checkpoint": true,
    "router_grad_diagnostic_every": 0,
    "full_checkpoint": true,
    "measure_forward_latency": true,
    "oracle_last_step_samples": 0,
    "partner_probe": {
      "interval_batches": 16,
      "weight": 0.1,
      "min_scale": 0.5,
      "grad_diagnostic_interval_batches": 0
    },
    "best_checkpoint_name": "best.pth",
    "save_last_checkpoint": true
  }
}
