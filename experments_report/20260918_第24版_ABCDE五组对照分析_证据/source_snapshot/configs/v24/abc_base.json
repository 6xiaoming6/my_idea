{
  "seed": 7,
  "output_dir": "outputs/v24-COE",
  "device": "cuda",
  "data": {
    "dataset_name": "TaxiBJ",
    "batch_size": 16,
    "num_workers": 0,
    "pin_memory": true,
    "drop_last": false,
    "mask": {
      "pattern": "random",
      "missing_rate": 0.4,
      "train_csv": "data/TaxiBJ/random_mask/0.4/train.csv",
      "val_csv": "data/TaxiBJ/random_mask/0.4/val.csv",
      "test_csv": "data/TaxiBJ/random_mask/0.4/test.csv"
    },
    "synthetic": {
      "num_train": 128,
      "num_val": 32,
      "t": 12,
      "h": 32,
      "w": 32
    },
    "multiscale": false,
    "loader_seed": 7
  },
  "model": {
    "architecture": "v24_ts_coe",
    "c_in": 2,
    "main": {
      "dim": 64,
      "max_t": 12,
      "h": 32,
      "w": 32,
      "scale_mode": "fine",
      "use_multiscale": false
    },
    "coe": {
      "num_steps": 2,
      "routing_mode": "hard",
      "fixed_path": [
        "T",
        "S"
      ],
      "router_state": "dynamic",
      "use_shared": true,
      "use_routed": true,
      "temperature": 1.0,
      "temporal_kernel": 3,
      "spatial_kernel": 3,
      "residual_init": 0.1
    },
    "aux": {
      "enabled": false,
      "alpha_init": 0.0
    }
  },
  "loss": {
    "type": "l1",
    "lambda_coe_mid": 0.0,
    "lambda_coe_balance": 0.0
  },
  "train": {
    "epochs": 80,
    "val_epoch": 2,
    "lr_main": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "amp": true,
    "save_every": 10,
    "scheduler": {
      "type": "cosine",
      "eta_min": 1e-06
    },
    "early_stopping": {
      "enabled": false,
      "monitor": "val_mae",
      "patience": 40,
      "mode": "min"
    },
    "save_best_checkpoint": false
  }
}
