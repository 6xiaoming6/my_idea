# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.so

# =============================================================================
# Virtual environments
# =============================================================================
.venv/
venv/
env/
.env

# =============================================================================
# IDE / Editor
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================================================
# Jupyter
# =============================================================================
.ipynb_checkpoints/
*.ipynb

# =============================================================================
# Datasets — DO NOT COMMIT (large binary files)
# =============================================================================
# LibCity grid files
*.grid
# NumPy arrays (raw flow data)
*.npy
# Preprocessed windowed data
*.npz
# Root dataset directory only. Do not ignore src/stmoe_imputer/data/.
/data/
# Regeneratable canonical files produced by imputation_benchmark/prepare_grid_dataset.py
/imputation_benchmark/data/

# =============================================================================
# imputation_benchmark — generated smoke-test configs (regenerated by generate_smoke_configs.py)
# =============================================================================
/imputation_benchmark/generated_configs/

# =============================================================================
# imputation_benchmark — run outputs (logs, summaries, experiments)
# =============================================================================
/imputation_benchmark/paper_runs/
/imputation_benchmark/smoke_runs/
/imputation_benchmark/experiments/
/imputation_benchmark/smoke_*/
/imputation_benchmark/paper_*/
/imputation_benchmark/policies/

# =============================================================================
# imputation_benchmark — per-model transient directories
# =============================================================================
# BRITS: prepared JSON data
/imputation_benchmark/BRITS/smoke_data/
/imputation_benchmark/BRITS/training_data/
# IGNNK: smoke experiments
/imputation_benchmark/IGNNK/smoke_experiments/
# ImputeFormer: runtime logs
/imputation_benchmark/imputeformer/logs/
# PriSTI: saved model checkpoints
/imputation_benchmark/PriSTI/PriSTI-main/save/
# SSTBAN: experiment checkpoints
/imputation_benchmark/SSTBAN/SSTBAN-imputation/experiments/
# GCASTN: experiment outputs
/imputation_benchmark/GCASTN/GCASTN-main/code_data_paper_632/GCASTN/experiments/
# Any best_model directories (saved parameters)
**/best_model/
**/save/

# =============================================================================
# imputation_benchmark — generated symlinks
# =============================================================================
/imputation_benchmark/data/smoke/*/*/*/TaxiBJ
/imputation_benchmark/data/smoke/*/*/*/BikeNYC
/imputation_benchmark/data/smoke/*/*/*/CHAP
/imputation_benchmark/data/adapted/*/*/*/TaxiBJ
/imputation_benchmark/data/adapted/*/*/*/BikeNYC
/imputation_benchmark/data/adapted/*/*/*/CHAP
/imputation_benchmark/data/adapted/*/*/*/split/TaxiBJ
/imputation_benchmark/data/adapted/*/*/*/split/BikeNYC
/imputation_benchmark/data/adapted/*/*/*/split/CHAP
/imputation_benchmark/imputeformer/configurations/TaxiBJ.yaml
/imputation_benchmark/imputeformer/configurations/BikeNYC.yaml
/imputation_benchmark/imputeformer/configurations/CHAP.yaml

# =============================================================================
# Model checkpoints (large, regeneratable)
# =============================================================================
*.pt
*.pth
checkpoints/

# =============================================================================
# Training outputs (logs, plots, saved configs from runs)
# =============================================================================
/outputs/
# /runs/
# /logs/
# /outputs/v2_smoke

# =============================================================================
# Matplotlib / plotting caches
# =============================================================================
*.png
*.pdf
.mplstyle

# =============================================================================
# Design docs (keep only if you want; comment out to include)
# =============================================================================
# If you want design docs in git, uncomment the next line:
# !design*.md

# =============================================================================
# Conda / pip
# =============================================================================
# conda environment (can be large)
*.tar.bz2
# pip freeze dumps
requirements-freeze.txt

# =============================================================================
# OS / misc
# =============================================================================
*.bak
*.tmp
*.log
